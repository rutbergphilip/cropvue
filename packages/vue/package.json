{
  "name": "@cropvue/vue",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Headless, fully customizable image cropping and upload components for Vue 3",
  "author": "Philip Rutberg",
  "keywords": [
    "vue",
    "vue3",
    "vue-cropper",
    "vue-image-cropper",
    "vue-image-crop",
    "vue3-cropper",
    "image-cropper",
    "image-crop",
    "image-editor",
    "image-upload",
    "avatar-cropper",
    "profile-picture",
    "photo-editor",
    "crop-component",
    "headless",
    "renderless",
    "drag-and-drop",
    "dropzone",
    "image-resize",
    "image-compress",
    "webp",
    "canvas",
    "nuxt",
    "typescript",
    "scoped-slots"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rutbergphilip/cropvue.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/rutbergphilip/cropvue",
  "bugs": "https://github.com/rutbergphilip/cropvue/issues",
  "main": "./dist/cropvue.cjs",
  "module": "./dist/cropvue.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/cropvue.mjs",
      "require": "./dist/cropvue.cjs"
    },
    "./styles": "./dist/styles.css"
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@cropvue/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "tailwind-merge": "^2.0.0 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "tailwind-merge": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  }
}
